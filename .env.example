# ---------------------------------------------------------------------------
# Tharwah Team Energy Matrix — environment variables
# Copy this file to .env (local dev) or set these in your hosting provider's
# secret manager. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Prisma format). Use a provider/region consistent
# with your PDPL data-residency decision — see README.md "Deployment decisions".
DATABASE_URL="postgresql://user:password@localhost:5432/energy_matrix?schema=public"

# 32+ character random secret used to encrypt the admin session cookie
# (iron-session). Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Admin login. The password is never stored — only its bcrypt hash.
# Create/reset both with: npm run admin:create
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Number of months raw, identifiable responses are retained before the
# retention job anonymizes them (see scripts/retention.ts and README §PDPL).
DATA_RETENTION_MONTHS="18"

# Set to "true" once you are running behind HTTPS (enables the Secure cookie flag).
# Leave "false" only for local http:// development.
FORCE_SECURE_COOKIES="true"
